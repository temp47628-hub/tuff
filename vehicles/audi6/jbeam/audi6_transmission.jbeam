"audi6_transfer_case_AWD_torsen": {
    "information":{
        "authors":"BeamNG",
        "name":"Quattro 50/50 Transfer Case",
        "value":1650,
    },
    "slotType" : "audi6_transfer_case",
    "controller": [
        ["fileName"],
        ["powertrainControl/activeCenterDiff", {"name":"activeCenterDiff"}]
    ],
    "activeCenterDiff": {
        "axleDiff1Name":"differential_F"
        "axleDiff2Name":"differential_R"
        "centerDiffName":"transfercase"
        //bias between accelerationLockMap and slipLockMap
        "biasOversteerVsTraction": 1
        //x: throttle input (0-1), y: vehicle velocity (m/s), z: desired lock (0-1)
        "throttleLockMap": [
            [    0,    0.5,   1]
            [0,  0,    0.04,  0.8]
            [12, 0,    0.4,   0.8]
            [60, 0,    0.08,  0.16]
        ]
        //x: throttle input (0-1), y: vehicle velocity (m/s), z: allowed slip (0-1)
        "allowedSlipMap": [
            [     0,   1]
            [0,   1,   0.1]
            [60,  1,   0.1]
        ]
        //x: slip in excess of allowed (0-1), y: vehicle velocity (m/s), z: desired lock (0-1)
        "slipLockMap": [
            [     0,   0.1,   1]
            [0,   0,   0.8,   1]
            [12,  0,   0.8,   1]
            [60,  0,   0.16,  1]
        ]
        //x: brake input (0-1), y: vehicle velocity (m/s), z: desired lock (0-1)
        "brakeLockMap": [
            [     0,   0.5,   1]
            [0,   0,   0.4,   0.4]
            [60,  0,   0.4,   0.4]
        ]
        //x: brake input (0-1), y: vehicle velocity (m/s), z: desired lock (0-1)
        //map is subtractive and applies when both throttle and brake are pressed, and throttle is > brake
        "leftFootBrakeLockMap": [
            [     0,   0.5,   1]
            [0,   0,   0.5,   0.5]
            [60,  0,   0.5,   0.5]
        ]
        //x: steering input (0-1), y: vehicle velocity (m/s), z: desired lock (0-1)
        //map is subtractive from the brake map
        "steeringLockMap": [
            [     0,   0.333,  1]
            [0,   0,   0.4,    0.4]
            [10,  0,   0.4,    0.4]
            [60,  0,   0.4,    0.4]
        ]
        //x: handbrake input (0-1), y: vehicle velocity (m/s), z: desired lock (0-1)
        "handbrakeLockMap": [
            [    0,   0.05,  0.1]
            [0,  1,   1,     0]
            [60, 1,   1,     0]
        ]
    }

    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["differential", "transfercase", "gearbox", 1, {"diffType":"activeLock", "lockTorque":550, "lockSpring":10000, "diffTorqueSplit":0.5, "friction":5, "uiName":"Center Differential","defaultVirtualInertia":0.1,"speedLimitCoef":0.1}],
    ],
	"flexbodies": [
		["mesh", "[group]:", "nonFlexMaterials"],
		["audi6_transfercase", ["audi6_engine","audi6_transmission"]],		
	],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--tcase weight--
         {"selfCollision":false},
         {"collision":false},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"audi6_transmission"},
         {"nodeWeight":36},
         ["tcase", 0.13, -0.79, 0.33],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":1500600,"beamDamp":60},
          {"beamDeform":30000,"beamStrength":"FLT_MAX"},
          ["tcase","e1r"],
          ["tcase","e3r"],
          ["tcase","e1l"],
          ["tcase","e3l"],
          ["tcase","tra1"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
