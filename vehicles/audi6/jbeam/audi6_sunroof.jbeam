{
"audi6_glass_sunroof": {
    "information":{
        "authors":"BeamNG",
        "name":"Sunroof Glass",
        "value":400,
    },
    "slotType" : "audi6_glass_sunroof",
    "controller": [
        ["fileName"],
        ["sunroofGlass"]
    ],
	"props": [
        ["func", "mesh", "idRef:","idX:","idY:", "baseRotationGlobal", "rotationGlobal", "translationGlobal", "min", "max", "offset", "multiplier"],
        //["", "audi6_intceiling_sedan_sunroof.006", "sunroof_main1l","sunroof_main1r","sunroof_main2l",  {"x":88, "y":0, "z":0}, {"x":0, "y":0, "z":0}    , {"x":0.0, "y":0.0, "z":0.0}, -1, 1, 0, 1],      
	],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["audi6_sunroof_glass", ["audi6_sunroof_tilt"]],
        {"disable":"$=$components.electrics.solarMesh ~= 1"},
        ["audi6_sunroof_solar", ["audi6_sunroof_tilt"]],
        {"disable":""},
        ["audi6_sunroof_glass_frame", ["audi6_sunroof_tilt"]],
    ],
	"triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type",  "size", 						  "baseRotation", 		 "rotation", 				  "translation", 					  "baseTranslation"],        
        ["sunroof_slide", "rf1", "rf1r", "rf2", "box", {"x":0.0171, "y":0.0196, "z":0.0376},  {"x":5, "y":355, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.0073, "y":0.0459, "z":-0.0769}],
        ["sunroof_tilt", "rf1", "rf1l", "rf2", "box", {"x":0.0171, "y":-0.0196, "z":0.0376},  {"x":355, "y":355, "z":0}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.0073, "y":0.0459, "z":0.0769}],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["sunroof_slide", "action0", "sunroof_slide"],
        ["sunroof_tilt", "action0", "sunroof_tilt"],
    ],
    "actionsEnabled": [
        ["id"],
		["sunroof_slide"],
		["sunroof_tilt"],
    ],
    "rails": {
        "sunroof_1_L":{
                "links:":["sunroof_rail1l", "sunroof_rail2l"], "broken:":[], "looped":false, "capped":true,
            },
            "sunroof_1_R":{
                "links:":["sunroof_rail1r", "sunroof_rail2r"], "broken:":[], "looped":false, "capped":true,  
        },    
    },
    "slidenodes": [
            ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
            ["sunroof_main1l", "sunroof_1_L", true, true, 0.0, 400000, "FLT_MAX", "FLT_MAX"],
            ["sunroof_main2l", "sunroof_1_L", true, true, 0.0, 400000, "FLT_MAX", "FLT_MAX"],
            
            ["sunroof_main1r", "sunroof_1_R", true, true, 0.0, 400000, "FLT_MAX", "FLT_MAX"],
            ["sunroof_main2r", "sunroof_1_R", true, true, 0.0, 400000, "FLT_MAX", "FLT_MAX"],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"nodeWeight":0.4},
         {"frictionCoef":0.8},
         {"nodeMaterial":"|NM_PLASTIC"},
         {"collision":false},
         {"selfCollision":false},

         //------ RAILS (fixed to body) ------
         {"group":"audi6_sunroof_glass_rail"},
         ["sunroof_rail1l", -0.3673, -0.1439, 1.426],	 
         ["sunroof_rail2l", -0.3673, 0.647, 1.4497],	
         ["sunroof_rail1r", 0.3673, -0.1439, 1.426],	 
         ["sunroof_rail2r", 0.3673, 0.647, 1.4497],	     

         //------ MAIN SLIDE NODES (ride on rails) ------
         {"group":"audi6_sunroof_glass"},
         ["sunroof_main1l", -0.3673, -0.1404, 1.4261],	 
         ["sunroof_main2l", -0.3673, 0.3108, 1.4393],	
         ["sunroof_main1r", 0.3673, -0.1404, 1.4261],	 
         ["sunroof_main2r", 0.3673, 0.3108, 1.4393],	      
         {"nodeWeight":0.4},
         ["sunroof_rigid", -0.0000, 0.0995, 1.4851],

         //------ TILT SURFACE (glass/frame flex to these) ------
         //front pair — hinge, beamed stiffly to main1 slide nodes
         {"group":"audi6_sunroof_tilt"},
         {"nodeWeight":0.3},
         ["sf_fl", -0.3673, -0.1404, 1.4291],
         ["sf_fr",  0.3673, -0.1404, 1.4291],
         //rear pair — lifted by tilt hydro
         ["sf_rl", -0.3673, 0.3108, 1.4423],
         ["sf_rr",  0.3673, 0.3108, 1.4423],
         //rigidifier
         ["sf_rig", 0.0, 0.10, 1.488],

         //------ TILT PUSH REFS (below rear, hydro base) ------
         //Z=1.408: above the roof panel (~1.40) but below the glass (1.4393)
         //gives ~0.031m of hydro travel before hitting glass rest position
         {"group":""},
         {"nodeWeight":0.3},
         ["sf_pbl", -0.3673, 0.3108, 1.408],
         ["sf_pbr",  0.3673, 0.3108, 1.408],

         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":151000,"beamDamp":50},
          {"beamDeform":18000,"beamStrength":"FLT_MAX"},
          {"deformLimitExpansion":1.1},
          {"deformationTriggerRatio":0.01},

          //====== RAIL SHAPE ======
          ["sunroof_rail1l","sunroof_rail2l"],
          ["sunroof_rail1r","sunroof_rail2r"],
          ["sunroof_rail2l","sunroof_rail2r"],
          ["sunroof_rail1l","sunroof_rail1r"],
          ["sunroof_rail1l","sunroof_rail2r"],
          ["sunroof_rail2l","sunroof_rail1r"],

          //====== MAIN SLIDE SHAPE ======
          ["sunroof_main1l","sunroof_main2l"],
          ["sunroof_main1l","sunroof_main1r"],
          ["sunroof_main1r","sunroof_main2r"],
          ["sunroof_main2l","sunroof_main2r"],
          ["sunroof_main2l","sunroof_main1r"],
          ["sunroof_main1l","sunroof_main2r"],
          
          //rigidifier
          {"beamSpring":121000,"beamDamp":100},
          {"beamDeform":248000,"beamStrength":"FLT_MAX"},
          ["sunroof_main1l","sunroof_rigid"],
          ["sunroof_main2l","sunroof_rigid"],
          ["sunroof_main2r","sunroof_rigid"],
          ["sunroof_main1r","sunroof_rigid"],

          //====== TILT SURFACE STRUCTURE ======
          {"beamSpring":151000,"beamDamp":50},
          {"beamDeform":18000,"beamStrength":"FLT_MAX"},
          //panel shape
          ["sf_fl","sf_fr"],
          ["sf_rl","sf_rr"],
          ["sf_fl","sf_rl"],
          ["sf_fr","sf_rr"],
          ["sf_fl","sf_rr"],
          ["sf_fr","sf_rl"],
          //rigidifier
          {"beamSpring":121000,"beamDamp":100},
          {"beamDeform":248000,"beamStrength":"FLT_MAX"},
          ["sf_fl","sf_rig"],
          ["sf_fr","sf_rig"],
          ["sf_rl","sf_rig"],
          ["sf_rr","sf_rig"],

          //====== TILT HINGE — front tilt nodes follow front slide nodes ======
          {"beamSpring":301000,"beamDamp":80},
          {"beamDeform":48000,"beamStrength":"FLT_MAX"},
          ["sf_fl","sunroof_main1l"],
          ["sf_fr","sunroof_main1r"],
          ["sf_fl","sunroof_main1r"],
          ["sf_fr","sunroof_main1l"],
          ["sf_fl","sunroof_main2l"],
          ["sf_fr","sunroof_main2r"],

          //====== TILT PUSH REFS — follow slide, stay low ======
          {"beamSpring":251000,"beamDamp":80},
          {"beamDeform":48000,"beamStrength":"FLT_MAX"},
          //attach to main2 slide nodes (follows slide along rail)
          ["sf_pbl","sunroof_main2l"],
          ["sf_pbr","sunroof_main2r"],
          ["sf_pbl","sunroof_main2r"],
          ["sf_pbr","sunroof_main2l"],
          //attach to main1 for triangulation
          ["sf_pbl","sunroof_main1l"],
          ["sf_pbr","sunroof_main1r"],
          //cross between push refs
          ["sf_pbl","sf_pbr"],

          //====== RAIL → BODY ======
          {"beamSpring":151000,"beamDamp":50},
          {"beamDeform":18000,"beamStrength":"FLT_MAX"},
          ["sunroof_rail1l","rf1r"],	  
          ["sunroof_rail1l","rf2r"],	  
          ["sunroof_rail1l","rf1"],	  
          ["sunroof_rail1l","rf2"],	  
          ["sunroof_rail1l","rf7"],	  

          ["sunroof_rail2l","rf2r"],	  
          ["sunroof_rail2l","rf3r"],	  
          ["sunroof_rail2l","rf4r"],	  
          ["sunroof_rail2l","rf2"],	  
          ["sunroof_rail2l","rf3"],	  
          ["sunroof_rail2l","rf4"],	
          ["sunroof_rail2l","rf7"],	
          
          ["sunroof_rail1r","rf1l"],	  
          ["sunroof_rail1r","rf2l"],	  
          ["sunroof_rail1r","rf1"],	  
          ["sunroof_rail1r","rf2"],	  
          ["sunroof_rail1r","rf7"],	  
	 
          ["sunroof_rail2r","rf2l"],	  
          ["sunroof_rail2r","rf3l"],	  
          ["sunroof_rail2r","rf4l"],	  
          ["sunroof_rail2r","rf2"],	  
          ["sunroof_rail2r","rf3"],	  
          ["sunroof_rail2r","rf4"],	 
          ["sunroof_rail2r","rf7"],	 

          {"disableTriangleBreaking":false},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},
    ],
    "hydros": [
            ["id1:","id2:"],
            //------ SLIDE HYDROS (existing) ------
            {"beamDeform":25500,"beamStrength":14500},
            {"beamSpring":101000,"beamDamp":100},
            ["sunroof_rail1l", "sunroof_main2l", {"inputSource":"sunroof_slide","inLimit":0,"outLimit":1.71,"inRate":0.45,"outRate":0.42,"inputFactor":1}],
            ["sunroof_rail1r", "sunroof_main2r", {"inputSource":"sunroof_slide","inLimit":0,"outLimit":1.71,"inRate":0.45,"outRate":0.42,"inputFactor":1}],

            //------ TILT UP HYDROS — driven by sunroof_tilt_up (0 to 1) ------
            {"beamDeform":25500,"beamStrength":"FLT_MAX"},
            {"beamSpring":151000,"beamDamp":100},
            ["sf_pbl", "sf_rl", {"inputSource":"sunroof_tilt_up","inLimit":0,"outLimit":4.0,"inRate":2.0,"outRate":2.0,"inputFactor":1}],
            ["sf_pbr", "sf_rr", {"inputSource":"sunroof_tilt_up","inLimit":0,"outLimit":4.0,"inRate":2.0,"outRate":2.0,"inputFactor":1}],

            //------ TILT DIP HYDROS — driven by sunroof_tilt_dip (0 to 1) ------
            //outLimit negative = compresses piston = rear dips during slide
            {"beamDeform":25500,"beamStrength":"FLT_MAX"},
            {"beamSpring":151000,"beamDamp":100},
            ["sf_pbl", "sf_rl", {"inputSource":"sunroof_tilt_dip","inLimit":0,"outLimit":-0.25,"inRate":4.0,"outRate":1.5,"inputFactor":1}],
            ["sf_pbr", "sf_rr", {"inputSource":"sunroof_tilt_dip","inLimit":0,"outLimit":-0.25,"inRate":4.0,"outRate":1.5,"inputFactor":1}],
    ],
},
