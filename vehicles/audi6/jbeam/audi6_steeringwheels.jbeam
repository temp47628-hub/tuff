"audi6_steer_4spoke_base": {
    "information":{
        "authors":"BeamNG",
        "name":"A6 4-Spoke Base Steering Wheel",
        "value":600,
    },
    "slotType" : "audi6_steer",
    "slots": [
        ["type", "default", "description"],
        ["audi6_steer_paddles","", "Steering Wheel Paddle Shifters"],
		["audi6_steer_heating","", "Heated Steering Wheel"],
    ],
    "props": [
        ["func",     "mesh",         "idRef:", "idX:", "idY:", "baseRotation",            "rotation",            "translation",         "min", "max", "offset", "multiplier"],

        // custom leather + custom stitching
        {"disable":"$=$components.electrics.steerExclusive ~= 1"},
        ["steering", "audi6_steer_4spoke_base", "f5l","f5r","dsh5", {"x":-5,"y":0,"z":180}, {"x":0,"y":0,"z":1}, {"x":0,"y":0,"z":0}, -1000, 1000, 0, 1, {"materialOverride":[["audi6_leather_color2","audi6_interior_exclusive"],["audi6_stitching_c","audi6_stitching_exclusive"]]}],
