        // default
        {"disable":"$=$components.electrics.steerExclusive == 1"},
        ["steering", "audi6_steer_4spoke_base", "f5l","f5r","dsh5", {"x":-5,"y":0,"z":180}, {"x":0,"y":0,"z":1}, {"x":0,"y":0,"z":0}, -1000, 1000, 0, 1],
