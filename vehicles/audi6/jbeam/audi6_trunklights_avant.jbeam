    },
    "slotType" : "audi6_trunklight_R_avant",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["audi6_trunklightframe_R_avant", ["audi6_trunklight_R"]],
		 
         {"deformGroup":"trunklight_R_break", "deformMaterialBase":"audi6_glass", "deformMaterialDamaged":"audi6_glass_dmg"},
         ["audi6_trunklightglass_R_avant", ["audi6_trunklight_R"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>extglassbreaksound2", "deformVolume":0.3}],
