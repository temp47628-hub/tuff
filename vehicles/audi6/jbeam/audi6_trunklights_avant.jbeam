         {"deformGroup":""},
		 
         {"deformGroup":"trunklight_R_break", "deformMaterialBase":"audi6_lights", "deformMaterialDamaged":"audi6_lights"},
         ["audi6_trunklight_R_avant", ["audi6_trunklight_R"]],
         {"deformGroup":""},
		 
         {"deformGroup":"trunklight_R_break", "deformMaterialBase":"audi6_lights", "deformMaterialDamaged":"audi6_lights"},
         ["audi6_trunklight_reflector_R_avant", ["audi6_trunklight_R"]],
         {"deformGroup":""},
    ],
    "slots2": [
        ["name",                 "allowTypes",             "denyTypes", "default",                       "description"],
        ["audi6_trunklight_taillight_R_bulb", ["led_modern_red_5W"], [], "led_modern_red_5W", "Taillight R",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "lowhighBrake",
          "$nodeRef":"trl2r", "$nodeX":"trl4r", "$nodeY":"trl1r",
          "$deformGroup":"trunklight_R_break",
