        ["audi6_airfilter","audi6_airfilter", "Air Filter", {"coreSlot":true}],
        ["audi6_exhaust","audi6_exhaust_a6", "Exhaust"],
        ["n2o_system","", "Nitrous Oxide System"],
        ["audi6_engine_i4_2.0_diesel_internals","audi6_engine_i4_2.0_diesel_internals", "Engine Long Block", {"coreSlot":true}],
        ["audi6_transmission","audi6_transmission_6M_20tdi", "Transmission"],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
    ],
    "mainEngine": {
        "idleRPM":800,
        //max capable
        "inertia":0.2,
        "friction":14,
        "dynamicFriction":0.15,
        "engineBrakeTorque":34,
        //"burnEfficiency":0.49,
        "burnEfficiency":[
            [0, 0.2],
            [0.05, 0.38],
            [0.4, 0.46],
            [0.7, 0.49],
            [1, 0.3],
        ],
        //fuel system
        "energyStorage": "mainTank",
        "requiredEnergyType":"diesel",

        //exhaust
        "particulates":0.04,
        "instantAfterFireCoef": 0,
        "sustainedAfterFireCoef": 0,

        //cooling and oil system
        "thermalsEnabled":true,
        "engineBlockMaterial":"aluminum",
        "oilVolume":4,
        "engineBlockAirCoolingEfficiency":24,

        //engine durability
        "cylinderWallTemperatureDamageThreshold":150,
        "headGasketDamageThreshold":1500000,
        "pistonRingDamageThreshold":1500000,
        "connectingRodDamageThreshold":2000000,
        "maxTorqueRating": 430,
        "maxOverTorqueDamage": 500,

        //node beam interface
        "torqueReactionNodes:":["e3r","e4r","e2l"],
        "waterDamage": {"[engineGroup]:":["engine_intake"]},
        "radiator": {"[engineGroup]:":["radiator"]},
        "engineBlock": {"[engineGroup]:":["engine_block"]},
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",

        //starter motor
        "starterSample":"event:>Engine>Starter>i4diesel_1990_eng",
        "starterSampleExhaust":"event:>Engine>Starter>i4diesel_1990_exh",
        "shutOffSampleEngine":"event:>Engine>Shutoff>i4diesel_1990_eng",
        "shutOffSampleExhaust":"event:>Engine>Shutoff>i4diesel_1990_exh",
        "starterVolume":0.76,
        "starterVolumeExhaust":0.76,
        "shutOffVolumeEngine":0.76,
        "shutOffVolumeExhaust":0.76,
        "idleRPMStartRate":1.5,
        "idleRPMStartCoef":1.0,

        //damage deformGroups
        "deformGroups":["mainEngine", "mainEngine_piping", "mainEngine_accessories"]
        "deformGroups_oilPan":["oilpan_damage"]
    },
    "vehicleController": {
        "clutchLaunchStartRPM":1400,
        "clutchLaunchTargetRPM":1800,
        //**highShiftDown can be overwritten by automatic transmissions**
        "highShiftDownRPM":[0,0,0,2400,2900,3200,3600,3600],
        //**highShiftUp can be overwritten by intake modifications**
        "highShiftUpRPM":4400,
    },
    "flexbodies": [
