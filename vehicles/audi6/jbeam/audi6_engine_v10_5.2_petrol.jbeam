],



        //engine performance
        "idleRPM":750,
        //max rpm physically capable of
        "maxRPM":9000,
        "inertia":0.16,
        "friction":19,
        "dynamicFriction":0.035,
        "engineBrakeTorque":46,
        //"burnEfficiency":0.33,
        "burnEfficiency":[
            [0, 0.1],
            [0.05, 0.22],
            [0.4, 0.34],
            [0.7, 0.38],
            [1, 0.31],
        ],
        //fuel system
        "energyStorage": ["mainTank","auxTank"],
        "requiredEnergyType":"gasoline",

        //exhaust
        "instantAfterFireSound": "event:>Vehicle>Afterfire>i5_01>single",
        "sustainedAfterFireSound": "event:>Vehicle>Afterfire>i5_01>multi",
        "shiftAfterFireSound": "event:>Vehicle>Afterfire>i5_01>shift",
        "particulates":0.015,
        "afterFireAudibleThresholdInstant": 500000,
        "instantAfterFireCoef": 0.75,
        "instantAfterFireVolumeCoef": 0.9,
        "afterFireAudibleThresholdShift": 150000,
        "shiftAfterFireVolumeCoef": 0.9,
        "afterFireAudibleThresholdSustained": 40000,
        "sustainedAfterFireCoef": 0.9,
        "sustainedAfterFireTime": 0.8,
        "sustainedAfterFireVolumeCoef": 0.7,

        //cooling and oil system
        "thermalsEnabled":true,
        "engineBlockMaterial":"aluminum",
        "oilVolume":8,
        "engineBlockAirCoolingEfficiency":39,

        //engine durability
        "torqueReactionNodes:":["e1l","e2l","e4r"],
        "cylinderWallTemperatureDamageThreshold":150,
        "headGasketDamageThreshold":1500000,
        "pistonRingDamageThreshold":1500000,
        "connectingRodDamageThreshold":2000000,
        "maxTorqueRating": 600,
        "maxOverTorqueDamage": 500,

        //node beam interface
        "waterDamage": {"[engineGroup]:":["engine_intake"]},
        "radiator": {"[engineGroup]:":["radiator"]},
        "engineBlock": {"[engineGroup]:":["engine_block"]},
        "breakTriggerBeam":"engine",
        "uiName":"Engine",
        "soundConfig": "soundConfig",
        "soundConfigExhaust": "soundConfigExhaust",

        //starter motor
        "starterSample":"event:>Engine>Starter>v8flat_1986_eng",
        "starterSampleExhaust":"event:>Engine>Starter>v8flat_1986_exh",
        "shutOffSampleEngine":"event:>Engine>Shutoff>v8flat_1986_eng",
        "shutOffSampleExhaust":"event:>Engine>Shutoff>v8flat_1986_exh",
        "starterVolume":0.76,
        "starterVolumeExhaust":0.76,
        "shutOffVolumeEngine":0.76,
        "shutOffVolumeExhaust":0.76,
        "starterThrottleKillTime":0.96,
        "idleRPMStartRate":2,
        "idleRPMStartCoef":2,

        //engine deform groups
        "deformGroups":["mainEngine", "mainEngine_intake", "mainEngine_accessories"]
    },
"soundConfig": {
    "sampleName": "audi6_v10audi_eng",
    "intakeMuffling": 0.65,        // increased: NA intake is less aggressive/raspy than TFSI
    "mainGain": 4,                  // reduced: overall quieter character
    "onLoadGain": 0.8,              // reduced: less dramatic load surge
    "offLoadGain": 0.25,            // slightly reduced
    "maxLoadMix": 0.6,              // reduced: smoother load transition, NA is more linear
    "minLoadMix": 0,
    "lowShelfGain": -2,             // cut low shelf: V10 FSI is leaner/less bassy than TFSI
    "lowShelfFreq": 300,
    "highShelfGain": 1,             // slight boost: V10 has more open high-freq presence
    "highShelfFreq": 3000,
    "eqLowGain": -2,                // cut low mids: removes the turbo thump/chug character
    "eqLowFreq": 650,
    "eqLowWidth": 0.15,
    "eqHighGain": -4,               // less aggressive high cut: V10 is more open/airy up top
    "eqHighFreq": 2000,
    "eqHighWidth": 0.25,
    "fundamentalFrequencyCylinderCount": 0,
    "eqFundamentalGain": 0,
},
"soundConfigExhaust": {
    "sampleName": "audi6_v10audi_exh",
    "mainGain": 0.8,                // reduced: quieter overall
    "onLoadGain": 0.85,             // reduced: less aggressive on-throttle bark
    "offLoadGain": 0.3,             // slightly reduced
    "maxLoadMix": 0.55,             // reduced: smoother, less dramatic load effect
    "minLoadMix": 0,
    "lowShelfGain": -8,             // heavier low cut: V10 FSI exhaust is not boomy
    "lowShelfFreq": 200,
    "highShelfGain": 4,             // boosted: V10 has that higher-pitched "wail/scream"
    "highShelfFreq": 4500,          // pushed higher for that NA high-rev character
    "eqLowGain": 4,                 // fixed missing comma; heavily reduced from 10 — less midrange aggression
    "eqLowFreq": 600,
    "eqLowWidth": 0.15,
    "eqHighGain": 5,                // reduced from 10: smoother upper mid presence
    "eqHighFreq": 1800,             // pushed slightly higher
    "eqHighWidth": 0.1,
    "fundamentalFrequencyCylinderCount": 0,
    "eqFundamentalGain": 0,
},
    "vehicleController": {
        "clutchLaunchStartRPM":1500,
