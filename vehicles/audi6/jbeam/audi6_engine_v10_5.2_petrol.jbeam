        ["n2o_system","", "Nitrous Oxide System"],
        ["audi6_engine_v10_5.2_petrol_internals","audi6_engine_v10_5.2_petrol_internals", "Engine Long Block", {"coreSlot":true}],
        ["audi6_transmission","audi6_transmission_6A", "Transmission"],
    ],
    "powertrain": [
        ["type", "name", "inputName", "inputIndex"],
        ["combustionEngine", "mainEngine", "dummy", 0],
    ],
    "mainEngine": {
"torque":[
