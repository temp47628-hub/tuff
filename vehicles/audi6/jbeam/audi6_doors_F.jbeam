        "authors":"BeamNG",
        "name":"Front A6 Right Door",
        "value":550,
    },
    "slotType" : "audi6_door_FR",
	"components": {
        "electrics": {
			"FRDoorMesh": 1,
        },
    },
    "slots": [
        ["type", "default", "description"],
        ["audi6_mirror_R","audi6_mirror_R", "Right Mirror"],
        ["audi6_doorglass_FR","audi6_doorglass_FR", "Front Right Door Glass"],
        
        ["audi6_doordetent_FR","audi6_doordetent_FR", "Front Right Door Detent"],
		["audi6_doorpanel_FR","audi6_doorpanel_FR", "Front Right Door Panel"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["audi6_mirror_frame_R", ["audi6_door_FR"]],
         ["audi6_door_FR", ["audi6_door_FR"]],
         ["audi6_doorframe_FR", ["audi6_door_FR"]],
         ["audi6_doorframe_seal_FR", ["audi6_door_FR"]],
         
         ["audi6_doorglass_frame_FR", ["audi6_door_FR"]],
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.03
    }
    "controller": [
        ["fileName"],
        ["advancedCouplerControl", {"name":"door_FR_coupler"}],
    ]
    "door_FR_coupler":{
        "couplerNodes":[
            ["cid1",    "cid2",     "autoCouplingStrength",    "autoCouplingRadius",   "autoCouplingLockRadius",   "autoCouplingSpeed", "couplingStartRadius",  "breakGroup"]
