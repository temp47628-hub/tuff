"audi6_wiper_R":{
    "information":{
        "authors":"BeamNG",
        "name":"Rear Wiper",
        "value":50,
    },
		
    "slotType" : "audi6_wiper_R",
	"components": {
        "electrics": {
			"hasRearWiper": 1,
        },
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //["audi6_wiper_RR", ["audi6_trunk"]],
    ],
	"audi6_workingWipers":{
		"rearWiperPresent": true,
		"rearWiperVolume": 0.6 //default is 1
	},
	
	"soundscape": [
        ["name","src"],
		{"node:":"int_strw", "descriptor":"AudioClosest3D"},
        ["rearWiperStalk","event:>Vehicle>Interior>Handbrake_Electric>Electric_01_Unlock"],
		{"node:":"t2", "descriptor":"AudioClosest3D"},
        ["rearWiper","art/sound/audi6/wipers/rear_wiper.mp3"],
    ],
    "props": [
        ["func"      , "mesh"              , "idRef:", "idX:", "idY:"            , "baseRotation"        , "rotation"                 , "translation"        , "min", "max", "offset", "multiplier"],
        ["wiperValR", "audi6_wiper_R", "t3", "t3r", "t2rr", {"x":171.961, "y":177.981, "z":1.601}, {"x":8, "y":170, "z":0}    , {"x":0, "y":0, "z":0}, 0, 1, 0, 1, {"deformGroup":""}],
    ],
    "actionsEnabled": [
        ["id"],
		["wiper_R"],
    ],
},
