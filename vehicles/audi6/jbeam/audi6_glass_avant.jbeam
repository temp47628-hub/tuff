{
"audi6_quarterglass_R_avant": {
    "information":{
        "authors":"BeamNG",
        "name":"Right Quarter Glass",
        "value":100,
    },
    "slotType" : "audi6_quarterglass_R_avant",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //glass
         {"deformGroup":"sideglass_R_break", "deformMaterialBase":"audi6_glass", "deformMaterialDamaged":"audi6_glass_dmg"},
         ["audi6_quarterglass_RR_avant", ["audi6_body"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound6", "deformVolume":0.7}],
		 {"deformGroup":"quarterglass_R_break", "deformMaterialBase":"audi6_glass_logo", "deformMaterialDamaged":"invis"},
         ["audi6_quarterglass_logo_RR_avant", ["audi6_body"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>glassbreaksound6", "deformVolume":0.7}],

         {"deformGroup":""},
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.01
    }
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},

         //--ADD WEIGHT--
         {"group":"audi6_body"},

         //rear quarter windows
         //c pillar
         {"nodeWeight":1.8},
         ["p10r", -0.7085, 1.456, 1.1745],
         //d pillar
         {"nodeWeight":3.1},
         ["p11r", -0.6913, 1.65, 1.18],
         //roof
         {"nodeWeight":2.3},
         ["rf4r", -0.5595, 0.986, 1.4489, {"group":["audi6_body","audi6_roof"]}],
         ["rf5r", -0.5564, 1.35, 1.4306, {"group":["audi6_body","audi6_roof"]}],
         ["rf6r", -0.5512, 1.7152, 1.3952, {"group":["audi6_body","audi6_roof"]}],
         //quarter panel
         {"nodeWeight":2.2},
         {"group":"audi6_body"},
         ["q1r", -0.82, 1.21, 0.91, {"group":["audi6_body","audi6_seat_R"]}],

         //windshield 12kg, rear window 10kg, coupe window 4kg, sedan window 3kg
         //1568kg

    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamSpring":1470600,"beamDamp":120},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //brittle glass beams
          {"beamSpring":1350600,"beamDamp":60},
          //side glass
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"beamDeform":4800,"beamStrength":8800},
          {"deformGroup":"sideglass_R_break", "deformationTriggerRatio":0.03},
          {"breakGroup":"sideglass_R"},
          ["rf5r","q2r"],
          ["rf5r","q1r"],
          ["q1r","p11r"],
          ["p11r","p10r"],
          ["p11r","rf4r"],
          ["rf6r","q1r"],
          {"breakGroup":""},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
          {"deformGroup":"", "deformationTriggerRatio":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},

    ],
},
