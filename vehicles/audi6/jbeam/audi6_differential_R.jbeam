{
"audi6_differential_R": {
    "information":{
        "authors":"BeamNG",
        "name":"Open Rear Differential",
        "value":1100,
    },
    "slotType" : "audi6_differential_R",
    "slots": [
        ["type", "default", "description"],
        ["audi6_driveshaft_R","audi6_driveshaft_R", "Rear Driveshaft"],
        ["audi6_halfshafts_R","audi6_halfshafts_R", "Rear Halfshafts"],
        ["audi6_finaldrive_R","audi6_finaldrive_R_3556", "Rear Final Drive", {"coreSlot":true}],
    ],
    "controller": [
        ["fileName"],
        ["drivingDynamics/actuators/electronicDiffLock" {"name":"lockRear", "differentialName":"differential_R"}]
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["differential", "differential_R", "driveshaft", 1, {"deformGroups":["differential_R"], "diffType":"open", "uiName":"Rear Differential","defaultVirtualInertia":0.25}],
    ],
    "differential_R": {
        "friction": 3.92,
        "dynamicFriction": 0.00184,
        "torqueLossCoef": 0.03,
        "visualPositionRelativeChildren":[[-0.6,0,0]]
    },
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["audi6_diff", ["audi6_subframe_R","audi6_body"]],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--diff weight--
         {"selfCollision":false},
         {"collision":false},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},
         {"group":"audi6_diff_R"},
         {"nodeWeight":40},
         ["rdiff", 0, 1.39, 0.26],
         {"group":""},
    ],
    "beams": [
          ["id1:", "id2:"],
          //differential node
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":4800600,"beamDamp":138},
          {"beamDeform":27000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"differential_R", "deformationTriggerRatio":0.001}
          ["rdiff","rx2r"],
          ["rdiff","rx2l"],
          ["rdiff","rx1r"],
          ["rdiff","rx1l"],
          ["rdiff","rx4r"],
          ["rdiff","rx4l"],
          ["rdiff","rx5r"],
          ["rdiff","rx5l"],
          {"deformGroup":"", "deformationTriggerRatio":""}
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
