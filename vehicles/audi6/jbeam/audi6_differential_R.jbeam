        ["shaft", "wheelaxleRR", "differential_R", 2, {"deformGroups":["wheelaxleRR"], "breakTriggerBeam":"halfshaft_RR", "uiName":"Rear Right Halfshaft", "friction":1.57, "dynamicFriction": 0.0037, "visualPositionRelativeChildren":[[0.3,0,0]]}],
