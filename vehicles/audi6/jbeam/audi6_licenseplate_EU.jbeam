          ["lph5f", "gri_1"],
          ["lph5f", "gri_2l"],
          ["lph5f", "gri_1l"],
          ["lph5f", "gri_2r"],
          ["lph5f", "gri_1r"],

          {"deformGroup":""}
          {"breakGroup":""},
