          {"beamSpring":130000,"beamDamp":10},
          {"beamDeform":15000,"beamStrength":2300},
          {"deformGroup":""}
          {"breakGroup":"licenseplateholder_F"},
          //to bumper
          ["lph3f", "gri_2"],
