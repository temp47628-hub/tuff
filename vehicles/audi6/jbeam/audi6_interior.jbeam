         {"group":["audi6_shifter_CVT","audi6_shifter_knob_A"]},
         {"nodeWeight":0.5}
         ["sh_l3", -0.003, -0.3819, 0.8064],
         {"selfCollision":false},
         {"nodeWeight":0.30}
         {"group":"audi6_shifter_knob_A"},
         ["sh_l1l", 0.0103, -0.3624, 0.7514],
