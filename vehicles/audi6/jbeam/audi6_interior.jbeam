"audi6_shifter_A": {
    "information":{
        "authors":"BeamNG",
        "name":"Automatic Shifter",
        "value":150,
    },
    "slotType" : "audi6_shifter",
	"components": {
        "electrics": {
			"automaticShifterMesh": 1,
        },
    },
    "slots":[
        ["type", "default", "description"],		
        ["audi6_shifter_knob_A","audi6_shifter_knob_A_a6", "Shifter Knob", {"coreSlot":true}],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
		{"disable":"$=$components.electrics.shifterExclusive ~= 1"},
        ["audi6_shifter_boot_A", ["audi6_console", "audi6_shifter_CVT"], [],{"materialOverride":[["audi6_leather_color2","audi6_interior_exclusive"],["audi6_stitching_c","audi6_stitching_exclusive"]]}],		
		{"disable":"$=$components.electrics.shifterExclusive ~= nil"},
        ["audi6_shifter_boot_A", ["audi6_console", "audi6_shifter_CVT"]],
		{"disable":""},
        ["audi6_shifter_base_A", ["audi6_console", "audi6_body","audi6_shifterbase_A"]],
    ],
    "glowMap":{
			
            //shifter
			"audi6_gear_P":{"simpleFunction":{"ignitionLevel2":0.5,"auto_p":0.5}, "off":"audi6_interior_symbs", "on":"audi6_interior_symbs_on2", "on_intense":"audi6_interior_symbs_on"},
			"audi6_gear_R":{"simpleFunction":{"ignitionLevel2":0.5,"auto_r":0.5}, "off":"audi6_interior_symbs", "on":"audi6_interior_symbs_on2", "on_intense":"audi6_interior_symbs_on"},
			"audi6_gear_N":{"simpleFunction":{"ignitionLevel2":0.5,"auto_n":0.5}, "off":"audi6_interior_symbs", "on":"audi6_interior_symbs_on2", "on_intense":"audi6_interior_symbs_on"},
			"audi6_gear_D":{"simpleFunction":{"ignitionLevel2":0.5,"auto_d":0.5}, "off":"audi6_interior_symbs", "on":"audi6_interior_symbs_on2", "on_intense":"audi6_interior_symbs_on"},
			"audi6_gear_S":{"simpleFunction":{"ignitionLevel2":0.5,"auto_s":0.5}, "off":"audi6_interior_symbs", "on":"audi6_interior_symbs_on2", "on_intense":"audi6_interior_symbs_on"},
			"audi6_gear_M":{"simpleFunction":{"ignitionLevel2":0.5,"auto_m":0.5}, "off":"audi6_interior_symbs", "on":"audi6_interior_symbs_on2", "on_intense":"audi6_interior_symbs_on"},
    },
    "controller": [
        ["fileName"],
        ["propAnimation/dualAxisLever", {"name":"dualAxisLever"}],
        ["gearindicator", {}],
    ]
	"dualAxisLever": {
		"orderedModeCoordinates": [
			["modeName",   "x",      "y"],
			["P",            0.0,     1],
			["R",            0.0,     0.3],
			["N",            0.0,     0.0],
			["D",            0.0,     -0.3],
			["S",            0.0,     -0.6],
			["M",            -1,     -0.3]
		],
		"impulseModeCoordinates": [
			["modeName",   "x",      "y"],
			["M+",         -1,     -0.0],
			["M-",         -1,     -0.6]
		],
		"modeChanges": [
			["mode1",   "mode2",    "intermediateCoordinates"],
			["D",       "M",        [{"x":0.0,"y":-0.3}]]
		],
		"moveSoundNode": ["sh_b3"],
		"moveSoundEvent": "event:>Vehicle>Interior>Gearshift>manual_modern_09_in",
		"moveSoundVolume": 0.5,
		//"demoModes":["M1","M2","M3","M4","M5","M6",]
		//"demoModes":["P","R", "N", "D","S","M1","M2","M3","M4","M5","M6"]
		"electricsNameMode": "gear"
	},
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":false},
         //--SHIFTER---  has to be jbeamed to allow for realistic movement
         {"group":["audi6_shifter_CVT","audi6_shifterbase_A"]},
         {"nodeWeight":0.45}
         ["sh_b1l",  0.025, -0.4593, 0.6909],
         ["sh_b1r",  -0.049, -0.4583, 0.6909],
