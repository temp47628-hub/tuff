          ["arm_1r","arm_hinge_r"],
          ["arm_1l","arm_hinge_l"],
          ["arm_1r","arm_hinge_l"],
          ["arm_1l","arm_hinge_r"],
          ["arm_1r","arm_rigid"],
          ["arm_1l","arm_rigid"],
          ["arm_hinge_r","arm_rigid"],
          ["arm_2r","arm_rigid"],
          ["arm_hinge_l","arm_rigid"],
          ["arm_2l","arm_rigid"],

          {"beamSpring":121000,"beamDamp":100},
          {"beamDeform":248000,"beamStrength":"FLT_MAX"},

          ["arm_hinge_l","arm_hinge_r"],
		  
          ["arm_hinge_l","dsh3"],
          ["arm_hinge_l","dsh4"],
          ["arm_hinge_l","f7l"],
          ["arm_hinge_l","f8l"],
          ["arm_hinge_l","f9l"],
