"audi6_strut_F_race": {
    "information":{
        "authors":"BeamNG",
        "name":"Race Front Coilovers",
        "value":3300,
    },
    "slotType" : "audi6_strut_F",

    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["audi6_strut_F", ["audi6_strut_F"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$springheight_F", "range", "+m", "Suspension", 0, -0.06, 0.04, "Spring Height", "Raise or lower the suspension height", {"stepDis":0.005, "subCategory":"Front"}],
        ["$spring_F", "range", "N/m", "Suspension", 80000, 15000, 160000, "Spring Rate", "Spring stiffness", {"stepDis":500, "subCategory":"Front"}],
        ["$damp_bump_F", "range", "N/m/s", "Suspension", 6000, 500, 12500, "Bump Damping", "Damper rate in compression", {"stepDis":100, "subCategory":"Front"}],
        ["$damp_rebound_F", "range", "N/m/s", "Suspension", 18000, 500, 25000, "Rebound Damping", "Damper rate in extension", {"stepDis":100, "subCategory":"Front"}]
    ],
    "beams": [
         ["id1:", "id2:"],
         //front springs without soft bump stop
         {"beamType":"|NORMAL"},
         {"beamDeform":15000,"beamStrength":150000},
         {"beamSpring":"$spring_F","beamDamp":0},
         //{"beamSpring":0,"beamDamp":0},
         //IMPORTANT: if precompressionRange is ~= nil then it supersedes beamPrecompression.
         //The case() is for backwards compatibility for old configs containing the "rideheight_F" variable.
         //To change the base ride height, edit the springheight_F offset in the expression.
         ["fh4r","fs1r", {"name":"spring_FR", "beamPrecompression":"$=$rideheight_F", "precompressionRange":"$=case($rideheight_F == nil, $springheight_F + 0.005, '')",
             "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":50,"volumeFactor":2.3,"decayFactor":50,"noiseFactor":0.01,"pitchFactor":1.0,"maxStress":4500}],
         ["fh4l","fs1l", {"name":"spring_FL", "beamPrecompression":"$=$rideheight_F", "precompressionRange":"$=case($rideheight_F == nil, $springheight_F + 0.000, '')",
             "soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":50,"volumeFactor":2.3,"decayFactor":50,"noiseFactor":0.01,"pitchFactor":1.0,"maxStress":4500}],
         //dampers
         {"beamPrecompression":1.0, "beamType":"|BOUNDED","beamLongBound":1.0,"beamShortBound":1.0},
         {"beamLimitSpring":0,"beamLimitDamp":0},
         {"beamSpring":0,"beamDamp":"$damp_bump_F"},
         ["fh1r","fs1r", {"name":"shock_FR", "beamDampRebound":"$damp_rebound_F","beamDampVelocitySplit":0.3,"beamDampFast":"$=$damp_bump_F / 3","beamDampReboundFast":"$=$damp_rebound_F / 3","dampCutoffHz":500}],
