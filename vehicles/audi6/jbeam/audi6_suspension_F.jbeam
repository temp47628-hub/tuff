          {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":10001000,"beamDamp":1500,"beamDeform":65000,"beamStrength":275000},
          ["fh6r","fh6l", {"dampCutoffHz":500,"deformGroup":"steeringF", "deformationTriggerRatio":0.005}],
