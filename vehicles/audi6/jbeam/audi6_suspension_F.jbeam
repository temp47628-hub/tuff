         {"group":"audi6_tierod_F"},
         {"nodeWeight":6},
         ["fh6r", -0.363, -1.496, 0.240],
         ["fh6l",  0.363, -1.496, 0.240],
         {"group":""},
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
