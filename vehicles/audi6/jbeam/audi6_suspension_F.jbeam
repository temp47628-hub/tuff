        //To change the base track width, edit the trackoffset_F offset in the expression.
        ["wheel_F_5","audi6_wheel_rs6_20x9_F", "Front Wheels", {"nodeOffset":{"x":"$=case($trackwidth_F == nil, $trackoffset_F+0.29, $trackwidth_F)", "y":-1.405, "z":0.33}}],
