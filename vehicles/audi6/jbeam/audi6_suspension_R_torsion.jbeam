{
"audi6_suspension_R_torsion": {
    "information":{
        "authors":"BeamNG",
        "name":"Torsion Beam Rear Suspension",
        "value":800,
    },
    "slotType" : "audi6_suspension_R",
    "slots": [
        ["type", "default", "description"],
        ["audi6_brake_R","audi6_brake_R", "Rear Brakes"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_R" variable.
        //To change the base track width, edit the trackoffset_R offset in the expression.
        ["wheel_R_5","audi6_wheel_rs6_20x9_R", "Rear Wheels", {"nodeOffset":{"x":"$=case($trackwidth_R == nil, $trackoffset_R+0.300, $trackwidth_R)", "y":1.43, "z":0.33}}],
        ["audi6_wheeldata_R_torsion","audi6_wheeldata_R_torsion", "Rear Spindles", {"coreSlot":true}],
        ["audi6_spring_R_torsion","audi6_spring_R_torsion", "Rear Springs"],
        ["audi6_shock_R_torsion","audi6_shock_R_torsion", "Rear Shocks"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //rear running gear
         ["audi6_hub_R_torsionbeam", ["audi6_hub_R"]],
         ["audi6_torsionbeam", ["audi6_hub_R", "audi6_torsionbeam_R"]],
         ["audi6_torsionbeam_mount", ["audi6_body"]],
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$camber_RR", "range", "", "Wheel Alignment", 0.984, 0.95, 1.05, "Camber Adjust", "Adjusts the wheel camber angles", {"subCategory":"Rear"}],
        ["$toe_RR", "range", "", "Wheel Alignment", 0.9975, 0.99, 1.01, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Rear"}],
        ["$trackoffset_R", "range", "+m", "Wheels", 0.0,-0.02, 0.05, "Wheel Offset", "Spacing of the wheel from the hub", {"stepDis":0.001,"subCategory":"Rear"}],
    ],
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         //--REAR TORSION BEAM SUSPENSION--
         {"collision":true},
         {"selfCollision":true},
         {"nodeMaterial":"|NM_METAL"},
         {"frictionCoef":0.5},

         //--TRAILING ARM PIVOTS--
         //these mount to the body floor and act as the pivot axis for the trailing arms
         {"nodeWeight":6.5},
         {"group":"audi6_torsionbeam_R"},
         ["rx1r",-0.56, 0.95, 0.28, {"tag":"rideheight_RR"}],
         ["rx1l", 0.56, 0.95, 0.28, {"tag":"rideheight_RL"}],

         //--REAR HUBS--
         {"collision":true},
         {"selfCollision":true},
         //hub lower - main wheel attachment point
         {"nodeWeight":8},
         {"group":["audi6_torsionbeam_R", "audi6_hub_R", "audi6_shock_R"]},
         ["rh1r",-0.72, 1.43, 0.20],
         ["rh1l", 0.72, 1.43, 0.20],
         //hub upper
         {"nodeWeight":4.5},
         {"group":["audi6_torsionbeam_R", "audi6_hub_R"]},
         ["rh2r",-0.72, 1.43, 0.46],
         ["rh2l", 0.72, 1.43, 0.46],

         //--TORSION BEAM CROSS MEMBERS--
         //inner beam nodes connecting left and right trailing arms
         {"selfCollision":false},
         {"nodeWeight":4.5},
         {"group":["audi6_torsionbeam_R", "audi6_hub_R"]},
         ["rh4r",-0.40, 1.2, 0.25],
         ["rh4l", 0.40, 1.2, 0.25],
         ["rh6r",-0.40, 1.2, 0.46],
         ["rh6l", 0.40, 1.2, 0.46],

         //--SPRING PERCH--
         //lower spring mount points on the trailing arms
         {"nodeWeight":3.5},
         {"group":["audi6_torsionbeam_R", "audi6_spring_R", "audi6_shock_R"]},
         ["rh3r",-0.46, 1.43, 0.25],
         ["rh3l", 0.46, 1.43, 0.25],

         {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        //twist beam - this is the core torsion beam element
        //controls anti-roll stiffness through the beam
        {"spring":1200, "damp":10, "deform":"FLT_MAX", "strength":"FLT_MAX"},
        ["rx1r", "rh4r", "rh4l", "rx1l"],
    ],
    "beams": [
          ["id1:", "id2:"],

          //--TRAILING ARM PIVOT MOUNTS TO BODY--
          //these attach the trailing arm pivot points to the body floor structure
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":501000,"beamDamp":2000},
          {"beamLimitSpring":7001000,"beamLimitDamp":500},
          {"beamDeform":25000,"beamStrength":220000},
          {"longBoundRange":0.00,"shortBoundRange":0.00,"boundZone":0.002},
          {"dampCutoffHz":500},
          {"breakGroup":"trailingarm_RR"},
          ["rx1r", "f4rr"],
          ["rx1r", "f4r"],
          ["rx1r", "f9r"],
          ["rx1r", "f3rr"],
          ["rx1r", "f3r"],
          ["rx1r", "f8r"],
          ["rx1r", "r1rr"],
          {"breakGroup":"trailingarm_RL"},
          ["rx1l", "f4ll"],
          ["rx1l", "f4l"],
          ["rx1l", "f9l"],
          ["rx1l", "f3ll"],
          ["rx1l", "f3l"],
          ["rx1l", "f8l"],
          ["rx1l", "r1ll"],
          {"breakGroup":""},
          {"dampCutoffHz":""},
          {"longBoundRange":"","shortBoundRange":"","boundZone":""},

          //--TRAILING ARM PIVOT LIMITERS--
          //prevent pivot drift during settling (matches independent suspension pattern)
          {"beamPrecompression":0.96, "beamType":"|SUPPORT", "beamLongBound":2},
          {"beamSpring":2001000,"beamDamp":180},
          {"beamDeform":15000,"beamStrength":80000},
          {"deformLimitExpansion":""},
          ["rx1r", "f4rr"],
          ["rx1r", "f9r"],
          ["rx1r", "r1rr"],
          ["rx1r", "f3rr"],
          ["rx1r", "f3r"],
          ["rx1r", "f8r"],
          ["rx1l", "f4ll"],
          ["rx1l", "f9l"],
          ["rx1l", "r1ll"],
          ["rx1l", "f3ll"],
          ["rx1l", "f3l"],
          ["rx1l", "f8l"],

          //--TORSION BEAM SUSPENSION--
          {"deformLimitExpansion":1.2},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},

          //beam to hub connections
          {"beamDeform":38000,"beamStrength":337500},
          {"beamSpring":10001000,"beamDamp":150},
          ["rh1l", "rh4l"],
          ["rh2l", "rh6l"],
          ["rh1l", "rh6l"],
          ["rh2l", "rh4l"],
          ["rh6l", "rh4l"],

          ["rh1r", "rh4r"],
          ["rh2r", "rh6r"],
          ["rh1r", "rh6r"],
          ["rh2r", "rh4r"],
          ["rh6r", "rh4r"],

          //hub to trailing arm pivot
          {"beamSpring":7001000,"beamDamp":150},
          ["rh1r", "rx1r"],
          ["rh2r", "rx1r"],

          ["rh1l", "rx1l"],
          ["rh2l", "rx1l"],

          //beam across (controls beam vertical bend stiffness)
          {"beamSpring":10001000,"beamDamp":150},
          ["rh4r", "rh4l"],
          ["rh6r", "rh6l"],
          //beam crossing (controls beam vertical shear)
          {"beamSpring":3001000,"beamDamp":150},
          ["rh6r", "rh4l"],
          ["rh4r", "rh6l"],

          //beam twist and lateral compliance
          {"beamSpring":1501000,"beamDamp":150},
          ["rh6r", "rx1l"],
          ["rh4r", "rx1l"],
          ["rh6l", "rx1r"],
          ["rh4l", "rx1r"],

          ["rh4l", "rx1l"],
          ["rh6l", "rx1l"],
          ["rh4r", "rx1r"],
          ["rh6r", "rx1r"],

          //lateral compliance through wheel
          {"beamSpring":2001000,"beamDamp":150},
          ["rw1r", "rh4l", {"breakGroup":"wheel_RR"}],
          ["rw1r", "rh6l", {"breakGroup":"wheel_RR"}],
          ["rw1l", "rh4r", {"breakGroup":"wheel_RL"}],
          ["rw1l", "rh6r", {"breakGroup":"wheel_RL"}],

          //spring perch structure
          {"beamSpring":7001000,"beamDamp":150},
          ["rh3l", "rh1l"],
          ["rh1l", "rh2l"],
          ["rh2l", "rh3l"],

          ["rh1r", "rh3r"],
          ["rh3r", "rh2r"],
          ["rh2r", "rh1r"],

          {"beamSpring":3501000,"beamDamp":150},
          ["rh3r", "rh4r"],
          ["rh3l", "rh4l"],

          //--ATTACH TO WHEEL--
          {"beamSpring":9001000,"beamDamp":150},
          {"beamDeform":78000,"beamStrength":275000},
          {"optional":true},
          {"breakGroup":"wheel_RR"},
          ["rh1r", "rw1r", {"name":"axle_RR"}],
          ["rh2r", "rw1r"],
          ["rh1r", "rw1rr"],
          ["rh2r", "rw1rr", {"beamPrecompression":"$camber_RR","beamPrecompressionTime":0.5}],
          ["rw1r", "rx1r", {"beamSpring":4501000}],
          ["rw1rr", "rx1r", {"beamSpring":4501000,"beamPrecompression":"$toe_RR","beamPrecompressionTime":0.5}],

          {"breakGroup":"wheel_RL"},
          ["rh1l", "rw1l", {"name":"axle_RL"}],
          ["rh2l", "rw1l"],
          ["rh1l", "rw1ll"],
          ["rh2l", "rw1ll", {"beamPrecompression":"$camber_RR","beamPrecompressionTime":0.5}],
          ["rw1l", "rx1l", {"beamSpring":4501000}],
          ["rw1ll", "rx1l", {"beamSpring":4501000,"beamPrecompression":"$toe_RR","beamPrecompressionTime":0.5}],
          {"breakGroup":""},
          {"optional":false},

          //--LIMITERS--
          //rear wheel limiters
          {"deformLimitExpansion":""},
          {"beamPrecompression":0.55, "beamType":"|SUPPORT", "beamLongBound":3},
          {"beamSpring":2501000,"beamDamp":500,"beamDeform":165000,"beamStrength":900000},
          {"optional":true},
          ["rw1r", "f4rr"],
          ["rw1r", "r2rr"],
          ["rw1r", "q7r", {"beamPrecompression":0.45}],
          ["rw1rr", "f4rr"],
          ["rw1rr", "r2rr"],
          ["rw1rr", "q7r", {"beamPrecompression":0.45}],

          ["rw1l", "f4ll"],
          ["rw1l", "r2ll"],
          ["rw1l", "q7l", {"beamPrecompression":0.45}],
          ["rw1ll", "f4ll"],
          ["rw1ll", "r2ll"],
          ["rw1ll", "q7l", {"beamPrecompression":0.45}],
          {"optional":false},

          //suspension travel hard limit
          {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
          {"beamSpring":0,"beamDamp":100,"beamDeform":15000,"beamStrength":150000},
          {"beamLimitSpring":1001000,"beamLimitDamp":600},
          ["rh3r", "r5rr", {"longBoundRange":0.11,"shortBoundRange":0.12,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh3l", "r5ll", {"longBoundRange":0.11,"shortBoundRange":0.12,"boundZone":0.025,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.2},
    ],
    "triangles": [
          ["id1:","id2:","id3:"],
          //rear torsion beam suspension
          {"triangleType":"NONCOLLIDABLE"},
          ["rh3l", "rh1l", "rh4l"],
          ["rh4l", "rh1l", "rx1l"],
          ["rh4r", "rx1r", "rh1r"],
          ["rh3r", "rh4r", "rh1r"],
          ["rh4r", "rh4l", "rx1l"],
          ["rh4l", "rx1r", "rh4r"],
          {"triangleType":"NORMALTYPE"},
    ],
    "pressureWheels": [
            ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
            //cancel out brake properties
            {"brakeTorque":0},
            {"parkingTorque":0},
            {"enableBrakeThermals":false},
            {"brakeDiameter":false},
            {"brakeMass":false},
            {"brakeType":false},
            {"rotorMaterial":false},
            {"brakeVentingCoef":false},
    ],
},
"audi6_shock_R_torsion": {
    "information":{
        "authors":"BeamNG",
        "name":"Rear Shocks",
        "value":120,
    },
    "slotType" : "audi6_shock_R_torsion",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["audi6_shock_R_torsionbeam", ["audi6_shock_R"]],
    ],
    "beams": [
          ["id1:", "id2:"],
          //rear shocks
          {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamDeform":15000,"beamStrength":150000},
          {"beamLimitSpring":0,"beamLimitDamp":0},
          {"beamSpring":0,"beamDamp":4000},
          ["rh1r","r1rr", {"name":"shock_RR", "beamDampFast":1600,"beamDampRebound":6800,"beamDampReboundFast":2267,"beamDampVelocitySplit":0.2,"dampCutoffHz":500}],
          ["rh1l","r1ll", {"name":"shock_RL", "beamDampFast":1600,"beamDampRebound":6800,"beamDampReboundFast":2267,"beamDampVelocitySplit":0.2,"dampCutoffHz":500}],
          //soft initial bumpstop
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":51000,"beamLimitDamp":1000},
          ["rh1r","r1rr", {"longBoundRange":1,"shortBoundRange":0.025,"boundZone":0.1,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh1l","r1ll", {"longBoundRange":1,"shortBoundRange":0.025,"boundZone":0.1,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          //hard bump stop
          {"beamSpring":0,"beamDamp":0},
          {"beamLimitSpring":251000,"beamLimitDamp":10000},
          ["rh1r","r1rr", {"longBoundRange":0.08,"shortBoundRange":0.08,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          ["rh1l","r1ll", {"longBoundRange":0.08,"shortBoundRange":0.08,"boundZone":0.05,"beamLimitDampRebound":0,"dampCutoffHz":500}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
"audi6_spring_R_torsion": {
    "information":{
        "authors":"BeamNG",
        "name":"Rear Springs",
        "value":180,
    },
    "slotType" : "audi6_spring_R_torsion",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["audi6_spring_R_torsionbeam", ["audi6_spring_R"]],
    ],
    "beams": [
          ["id1:", "id2:"],
          //rear springs
          {"beamPrecompression":1, "beamType":"|NORMAL"},
          {"beamDeform":15000,"beamStrength":150000},
          {"beamSpring":22000,"beamDamp":0},
          ["rh3r","r1rr", {"name":"spring_RR", "precompressionRange":0.121,"soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":30,"volumeFactor":1.7,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":5300}],
          ["rh3l","r1ll", {"name":"spring_RL", "precompressionRange":0.121,"soundFile":"event:>Vehicle>Suspension>car_modn_med_01>spring_compress_01","colorFactor":0.4,"attackFactor":30,"volumeFactor":1.7,"decayFactor":6,"noiseFactor":0.01,"pitchFactor":0.2,"maxStress":5300}],
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},
"audi6_wheeldata_R_torsion": {
    "information":{
        "authors":"BeamNG",
        "name":"Rear Spindles",
        "value":0,
    },
    "slotType" : "audi6_wheeldata_R",
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //rear
        {"selfCollision":false},
        {"collision":true},
        {"hubcapBreakGroup":"hubcap_RR"},
        {"hubcapGroup":"hubcap_RR"},
        {"axleBeams":["axle_RR"]},
        ["RR", "wheel_RR", "tire_RR", "rw1rr", "rw1r", 9999, "rx1r", 1,  {"torqueCoupling:":"rdiff", "torqueArm:":"rx1r", "torqueArm2:":"rx1l"}],
        {"hubcapBreakGroup":"hubcap_RL"},
        {"hubcapGroup":"hubcap_RL"},
        {"axleBeams":["axle_RL"]},
        ["RL", "wheel_RL", "tire_RL", "rw1ll", "rw1l", 9999, "rx1l", -1, {"torqueCoupling:":"rdiff", "torqueArm:":"rx1l", "torqueArm2:":"rx1r"}],
        {"selfCollision":true},
        {"axleBeams":[]},
        {"disableMeshBreaking":false,"disableTriangleBreaking":false},
        {"hubcapBreakGroup":""},
        {"hubcapGroup":""},
        {"enableHubcaps":false},
        {"enableTireLbeams":false},
        {"enableTireSideReinfBeams":false},
        {"enableTireReinfBeams":false},
        {"enableTreadReinfBeams":false},
        {"enableTirePeripheryReinfBeams":false},
        {"loadSensitivitySlope":""},
        {"noLoadCoef":""},
        {"fullLoadCoef":""},
        {"frictionCoef":""},
        {"slidingFrictionCoef":""},
        {"softnessCoef":0.5},
        {"treadCoef":1.0},
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        ["shaft", "spindleRL", "wheelaxleRL", 1, {"connectedWheel":"RL", "breakTriggerBeam":"axle_RL", "uiName":"Rear Left Axle", "friction":1.26, "dynamicFriction":0.0034}],
        ["shaft", "spindleRR", "wheelaxleRR", 1, {"connectedWheel":"RR", "breakTriggerBeam":"axle_RR", "uiName":"Rear Right Axle", "friction":1.26, "dynamicFriction":0.0034}],
    ],
},
}
