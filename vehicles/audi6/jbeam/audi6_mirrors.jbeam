{
"audi6_mirror_finish": {
    "information":{
        "authors":"BeamNG",
        "name":"Body Colored",
        "value":180,
    },
    "slotType" : "audi6_mirror_finish",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],

         // PFL - show when mirror_FL == 0 AND no allroad mirror installed
         {"disable":"$=($components.electrics.mirror_FL or 0) ~= 0"}
         ["audi6_mirror_L_pfl", ["audi6_mirror_L"]],
         {"disable":"$=($components.electrics.mirror_FR or 0) ~= 0"}
         ["audi6_mirror_R_pfl", ["audi6_mirror_R"]],

         // Allroad - show when mirror_FL / mirror_FR == 2
         {"disable":"$=($components.electrics.mirror_FL or 0) ~= 2"}
         ["audi6_mirror_L_allroad", ["audi6_mirror_L"]],
         {"disable":"$=($components.electrics.mirror_FR or 0) ~= 2"}
         ["audi6_mirror_R_allroad", ["audi6_mirror_R"]],

         // FL normal - show when mirror_FL == 1 AND hasSideAssist == 0
         {"disable":"$=(($components.electrics.mirror_FL or 0) ~= 1) or (($components.electrics.hasSideAssist or 0) == 1)"}
         ["audi6_mirror_L_fl", ["audi6_mirror_L"]],
         {"disable":"$=(($components.electrics.mirror_FR or 0) ~= 1) or (($components.electrics.hasSideAssist or 0) == 1)"}
         ["audi6_mirror_R_fl", ["audi6_mirror_R"]],

         // FL side assist - show when mirror_FL == 1 AND hasSideAssist == 1
         {"disable":"$=(($components.electrics.mirror_FL or 0) ~= 1) or (($components.electrics.hasSideAssist or 0) == 0)"}
         ["audi6_mirror_L_blis_fl", ["audi6_mirror_L"]],
         {"disable":"$=(($components.electrics.mirror_FR or 0) ~= 1) or (($components.electrics.hasSideAssist or 0) == 0)"}
         ["audi6_mirror_R_blis_fl", ["audi6_mirror_R"]],

         {"disable":""}
    ],
},
