        ["audi6_differential_R","audi6_differential_R", "Rear Differential"],
        //The case() is for backwards compatibility for old configs that use "trackwidth_R" variable.
        //To change the base track width, edit the trackoffset_R offset in the expression.
        ["wheel_R_5","audi6_wheel_rs6_20x9_R", "Rear Wheels", {"nodeOffset":{"x":"$=case($trackwidth_R == nil, $trackoffset_R+0.300, $trackwidth_R)", "y":1.43, "z":0.33}}],
        ["audi6_wheeldata_R","audi6_wheeldata_R", "Rear Spindles", {"coreSlot":true}],
        ["audi6_spring_R","audi6_spring_R", "Rear Springs"],
