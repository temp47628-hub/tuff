        ["brake_disc_drilled", ["wheel_FL","wheelhub_FL"], [], {"pos":{"x":0.80,"y":-1.405, "z":0.33}, "scale":{"x":1.3,"y":1.21,"z":1.21}, "rot":{"x":180,"y":180,"z":0}, "materialOverride":[["disc_brake", "disc_brake_FL"]]}],
        ["brake_caliper_6pot_red_rotopad", ["audi6_hub_FR","wheelhub_FR"], [], {"pos":{"x":-0.80,"y":-1.405, "z":0.33}, "scale":{"x":1.3,"y":1.21,"z":1.21}, "rot":{"x":-180,"y":0,"z":0}}],
        ["brake_caliper_6pot_red_rotopad", ["audi6_hub_FL","wheelhub_FL"], [], {"pos":{"x":0.80,"y":-1.405, "z":0.33}, "scale":{"x":1.3,"y":1.21,"z":1.21}, "rot":{"x":180,"y":180,"z":0}}],
