    "information":{
        "authors":"BeamNG",
        "name":"Right Fender Light",
        "value":400,
    },
    "slotType" : "audi6_fenderlight_R",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
		 ["audi6_fenderlightframe_R", ["audi6_fenderlight_R"]],
