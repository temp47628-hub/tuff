        ["audi6_fender_R_signal_bulb", ["incandescent_amber_5W"], [], "incandescent_amber_5W", "Fender Signal",
        {
        "coreSlot":true,
        "variables":{
          "$electric": "signal_R_s",
          "$nodeRef":"flight_1r", "$nodeX":"flight_2r", "$nodeY":"flight_3r",
