    "nodes": [
        ["id", "posX", "posY", "posZ"],
        {"nodeMaterial":"|NM_METAL"},
        {"frictionCoef":0.5},
        //main
        {"collision":true},
        {"selfCollision":true},
        {"nodeWeight":0.4},
        {"group":"audi6_fenderlight_R"},
        ["flight_1r", -0.8842,-0.9936,0.8861],
        ["flight_2r", -0.8859,-0.9297,0.8885],
        ["flight_3r", -0.9059,-0.959,0.8043],

        //rigidifier
        {"group":""},
        ["flight_5r", -0.8731,-0.9596,0.8477, {"collision":false,"selfCollision":false}],
    ],
    "beams": [
          ["id1:", "id2:"],
          //Fender Turn Signal
          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"beamSpring":701000,"beamDamp":10},
          {"beamDeform":15000,"beamStrength":"FLT_MAX"},
          {"deformGroup":"fenderlightglass_R_break", "deformationTriggerRatio":0.1},
          //main shape
          ["flight_1r", "flight_2r"],
          ["flight_2r", "flight_3r"],
          //["flight_3r", "flight_4r"],

          //crossing
          ["flight_1r", "flight_3r"],
          //["flight_1r", "flight_4r"],

          //rigidifier
          {"beamSpring":1051000,"beamDamp":80},
          {"beamDeform":13000,"beamStrength":"FLT_MAX"},
          ["flight_5r", "flight_1r"],
          ["flight_5r", "flight_2r"],
          ["flight_5r", "flight_3r"],
          //["flight_5r", "flight_4r"],

          //attach
          {"beamSpring":501000,"beamDamp":10},
          {"beamDeform":13000,"beamStrength":3000},
          {"breakGroup":"fenderlight_R"},
          ["fem1r", "flight_1r"],
          ["fem1r", "flight_2r"],
          ["fem1r", "flight_3r"],

          ["fem2r", "flight_1r"],
          ["fem2r", "flight_2r"],
          ["fem2r", "flight_3r"],

          ["fe4r", "flight_1r"],
          ["fe4r", "flight_2r"],
          ["fe4r", "flight_3r"],

          ["fe3r", "flight_1r"],
          ["fe3r", "flight_2r"],
          ["fe3r", "flight_3r"],

          //body
          {"beamType":"|SUPPORT"},

          {"beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformGroup":""}
          {"breakGroup":""},
    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            {"groundModel":"metal"},
            {"group":"audi6_fenderlight_R"},

            ["flight_1r", "flight_2r", "flight_3r"],
