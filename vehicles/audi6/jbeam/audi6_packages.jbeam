                ["refNode", "translation", "direction"],
                ["fb2ll", "0.178, 0.1, 0", "0.45, -1, 0"],
                ["fb2ll", "0.178, 0.1, 0", "0.21, -1, -0.1"],
                ["fb2l", "0.17, 0.1, 0", "0.225, -1, 0"],
                ["fb2l", "0.17, 0.1, 0", "-0.025, -1, -0.1"],
