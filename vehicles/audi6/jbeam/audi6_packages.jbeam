"audi6_parkingsystem_advanced": {
    "information":{
        "authors":"BeamNG",
        "name":"Audi Parking System Advanced",
        "value":90,
    },
    "slotType" : "audi6_parkingsystem_package",
	"components": {
        "electrics": {
			"frontParkingSensorsMesh": 1,
			"rearParkingSensorsMesh": 1,
			"reverseCameraMesh": 1,
            "customValues": [
                ["electricsName", "electricsFunction","electricsDefault"],
				["frontParkingSensorsEnabled","electrics.frontParkingSensorsEnabled",1],
				["rearParkingSensorsEnabled","electrics.rearParkingSensorsEnabled",1],
				["reverseCameraEnabled","electrics.reverseCameraEnabled",1],
            ],
            "smoothers": [
                ["electricsName", "smootherType", "params"],
            ],
        },
    },
    "glowMap":{
			"audi6_button_parkingsensors":{"simpleFunction":{"button_isPARKINGSENSORS":0.5}, "off":"audi6_interior_symbs", "on":"audi6_interior_symbs_on", "on_intense":"audi6_interior_symbs_on"},
			"audi6_reversecam":{"simpleFunction":{"ignitionLevel":0.1, "reverseCam":0.4}, "off":"invis", "on":"invis", "on_intense":"audi6_reversemirror"},
			"audi6_reversecam_overlay":{"simpleFunction":{"ignitionLevel":0.1, "reverseCam":0.4}, "off":"invis", "on":"invis", "on_intense":"audi6_zeit_reversecam_overlay"},
    },
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["button_parkingsensors",  "f5l","f5r","dsh5", "box", {"x":0.027, "y":0.008, "z":0.015}, {"x":94, "y":0, "z":-1.5}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.4560, "y":0.5002, "z":0.0003}],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["button_parkingsensors", "action0", "button_parkingsensors"],
    ],
