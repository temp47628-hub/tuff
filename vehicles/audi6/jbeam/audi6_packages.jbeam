         ["audi6_button_parkingsensors", ["audi6_dash"]],
		 {"disable":"$=$components.electrics.bigScreenMesh ~= 1"},
         {"deformGroup":"display_break", "deformMaterialBase":"audi6_reversecam", "deformMaterialDamaged":"invis"},
         ["audi6_reversecam", ["audi6_dash"]],         
         ["audi6_reversecam_overlay", ["audi6_dash"]],
         {"deformGroup":""},
		 {"disable":""},
    ],
	    "controller": [
            ["fileName"],
            ["parkingBeeper", {"name": "parkingBeeper"}],
			["reverseCam", {
					"texTargetName":"@audi6_zeit_reversecam",
					"camNodes":{"idRef": "rb2", "idX":"rb3", "idY":"rb2r"},
					"res": [512, 256],
					"clip": [0.1, 200],
					"fov": 70,
					"rotOffset":{"x":0.014, "y":0.5, "z":-0.0},
					"posOffset":{"x":0, "y":0.00, "z":-0.00},
				}],
		    ["reverseCamOverlay", {"materialName":"@audi6_zeit_reversecam_overlay"}],
        ],

        "parkingBeeper": {
			//front
            "frontBumperBreakGroupName": "frontbumper_M",
