"audi6_partitionnet": {
    "information":{
        "authors":"BeamNG",
        "name":"Partition Net",
        "value":90,
    },
    "slotType" : "audi6_partitionnet",
    "triggers2":[
        ["id", "idRef:", "idX:", "idY:", "type", "size", "baseRotation", "rotation", "translation", "baseTranslation"],
        ["partitionnet", "r1", "r1rr", "r5", "box", {"x":0.0156, "y":0.0222, "z":0.0100}, {"x":90.000, "y":0.000, "z":0.000}, {"x":0, "y":0, "z":0}, {"x":0, "y":0, "z":0}, {"x":0.0000, "y":-0.0790, "z":0.5333}],
    ],
    "triggerEventLinks2":[
        ["triggerId:triggers2", "triggerInput", "inputAction"],
        ["partitionnet", "action0", "partitionnet"],
    ],
    "actionsEnabled": [
        ["id"],
        ["partitionnet"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         ["audi6_partitionnet", ["audi6_partitionnet"]],
    ],
	"nodes": [
         ["id", "posX", "posY", "posZ"],
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_METAL"},
         {"collision":true},
         {"selfCollision":true},
         //scope
         {"nodeWeight":0.7},
         {"group":"audi6_partitionnet"},
         ["pnet4", -0.4626, 1.3312, 1.063],
         ["pnet3", 0.4626, 1.3312, 1.3942],
         ["pnet2", 0.4626, 1.3312, 1.063],
         ["pnet1", -0.4626, 1.3312, 1.3942],

		 {"group":"audi6_partitionnet2"},
		 {"collision":false},
		 {"selfCollision":false},

		 ["pnet44", -0.4626, 1.3218, 1.0596],
         ["pnet33", 0.4626, 1.3218, 1.3908],
         ["pnet22", 0.4626, 1.3218, 1.0596],
         ["pnet11", -0.4626, 1.3218, 1.3908],
         //rigidifier
         {"group":""},
		 {"collision":false},
    ],
    "beams": [
          ["id1:", "id2:"],
          {"breakGroupType":0},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamDeform":555,"beamStrength":175000},
          {"beamSpring":801000,"beamDamp":100},
          {"deformationTriggerRatio":0.03},
          //main shape
          {"deformLimitExpansion":1.1},
          {"disableTriangleBreaking":true},
          ["pnet33","pnet22"],
		  ["pnet44", "pnet11"],

          {"beamDeform":4500,"beamStrength":"FLT_MAX"},
          //surficial crossing
          {"deformLimitExpansion":""},
          {"beamDeform":13972.5,"beamStrength":175000},
          //rigidifier
          {"beamDeform":6682.5,"beamStrength":175000},

          //attach
          {"disableTriangleBreaking":true},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
          {"beamDeform":450500,"beamStrength":4444150},
          {"beamSpring":801000,"beamDamp":100},

           ["pnet4", "q5r"],
           ["pnet4", "q2r"],
           ["pnet4", "q4r"],
           ["pnet4", "q1r"],
           ["pnet2", "q5l"],
           ["pnet2", "q2l"],
           ["pnet2", "q4l"],
           ["pnet2", "q1l"],

           ["pnet44", "q5r"],
           ["pnet44", "q2r"],
           ["pnet44", "q4r"],
           ["pnet44", "q1r"],
           ["pnet22", "q5l"],
           ["pnet22", "q2l"],
           ["pnet22", "q4l"],
           ["pnet22", "q1l"],
			
           ["pnet11", "q5r"],
           ["pnet11", "q2r"],
           ["pnet11", "q4r"],
           ["pnet11", "q1r"],
           ["pnet33", "q5l"],
           ["pnet33", "q2l"],
           ["pnet33", "q4l"],
           ["pnet33", "q1l"],


          //support beams
          {"beamType":"|SUPPORT", "beamLongBound":8},
          {"beamSpring":830830,"beamDamp":100.8},
          {"beamDeform":10125,"beamStrength":630000},
          //hood
          {"optional":true},

          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.0},
          ["pnet8","pnet9"],
		
          {"beamSpring":200,"beamDamp":100},
          {"beamPrecompression":1.0, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"disableTriangleBreaking":true},
          ["pnet3","pnet1"],

    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            {"group":"audi6_partitionnet"},
            {"pnetroundModel":"plastic"},
            {"dragCoef":8},
            ["pnet2", "pnet3", "pnet1"],
            ["pnet2", "pnet1", "pnet4"],
            {"group":""},
            //gap
            {"dragCoef":0},
            {"breakGroup":""},
    ],
	"rails": {
		"pnet_rail1":{"links:":["pnet22", "pnet33"], "looped":false, "capped":true},
		"pnet_rail2":{"links:":["pnet44", "pnet11"], "looped":false, "capped":true}
	},
	"slidenodes": [
		["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
		["pnet3", "pnet_rail1", true, true, 0.0, 1001000, 10000, "FLT_MAX"],
		["pnet1", "pnet_rail2", true, true, 0.0, 1001000, 10000, "FLT_MAX"],
	],
	"hydros": [
            ["id1:", "id2:"],
            {"beamDeform":30000,"beamStrength":150000},
            {"beamSpring":25500,"beamDamp":250},
            {"beamLimitSpring":0,"beamLimitDamp":0},
            ["pnet22","pnet3",{"inputSource":"partitionnet","inLimit":1.0,"outLimit":0.01,"inRate":1.5,"outRate":10.0,"inputFactor":1}],
            ["pnet44","pnet1",{"inputSource":"partitionnet","inLimit":1.0,"outLimit":0.01,"inRate":1.5,"outRate":10.0,"inputFactor":1}],
            {"beamSpring":10500,"beamDamp":250},
            {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
    ],
},

