{
"audi6_gauges_screen_basic_pfl": {
    "information":{
        "authors":"BeamNG",
        "name":"Monochrome Pre-Facelift Gauge Screen",
        "value":200,
    },
    "slotType" : "audi6_gauges_screen_pfl",
	"components": {
        "electrics": {
			"adaptiveCruiseControl": 0,
        },
    },
    "controller": [
        ["fileName"],

        ["gauges/genericGauges", {"name":"gauge" }],
		["gauges/customModules/environmentData"],
		["gauges/customModules/combustionEngineData"],
    ],
    "gauge": {
        "configuration": {
            "materialName": "@audi6_gauges_screen",
            "htmlPath": "local://local/vehicles/audi6/gauges_screen/gauges_screen.html",
            "displayWidth":512,
            "displayHeight":512,
            "bodyStyle":{
                "background": "#050000",
                "font-family": "OpenSans",
                "font-size": "37px",
                "color": "#ffffff"
            },
        }
        "displayData": {
            "electrics": [
                "ignitionLevel",
                "battery",
                "signal_L",
                "signal_R",
                "lights",
                "highbeam",
                "fog",
                "lowpressure",
                "lowfuel",
                "parkingbrake",
                "checkengine",
                "gear",//
                "fuel",
                "wheelspeed",//
                "esc",
                "escActive",
                "tcs",
                "tcsoff",
                "tcsActive"
				"audi6_odo",
				"odometer",
				"throttle",
				"gMenu",
				"high_watertemp",
				"tempLeft",
				"tempRight",
				"gaugesMenu",
				"resetTrip",
				"manualShifterEnabled",
				"door_FL_coupler_notAttached",
				"door_FR_coupler_notAttached",
				"door_RL_coupler_notAttached",
				"door_RR_coupler_notAttached",
				"hoodLatchCoupler_notAttached",
				"trunkCoupler_notAttached",
                "trip",
				"button_econ",
				"button_fan",
				"button_heatedseat1",
				"button_heatedseat2",
				"button_airflow1",
				"button_airflow2",
				"audi6_currentSongName"
				"hvac_context",
            ]
			"customModules": [
                ["moduleName", "property"]
                ["combustionEngineData", "remainingRange"]
                ["combustionEngineData", "fuelConsumption"]
                ["environmentData", "temperatureEnv"]
                ["environmentData", "time"]
            ]
        }
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        {"deformGroup":"display_break", "deformMaterialBase":"audi6_screen", "deformMaterialDamaged":"screen_off"},
        ["audi6_gauges_screen", ["audi6_dash"]],
        {"deformGroup":""},
    ],
    "glowMap":{
        "audi6_gauges_screen":{"simpleFunction":{"ignitionLevel2":0.5}, "off":"screen_off", "on":"audi6_gauges_screen", "on_intense":"audi6_gauges_screen"},
    },
},
