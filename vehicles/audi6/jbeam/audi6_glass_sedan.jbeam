{
"audi6_wipers_F":{
    "information":{
        "authors":"BeamNG",
        "name":"Front Wipers",
        "value":50,
    },
		
    "slotType" : "audi6_wipers_F",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //["audi6_wiper_ref", ["audi6_windshield"]],
    ],
	"props": [
        ["func",       "mesh",               "idRef:", "idX:", "idY:",  "baseRotation",            "rotation",               "translation",          "min", "max", "offset", "multiplier"],
        ["wipers_position", "audi6_wiper_FL", "f6l", "f6r", "wi1", {"x":-99.279, "y":179.352, "z":-0.145}, {"x":0, "y":6, "z":-85}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1],
		["wipers_position", "audi6_wiper_FR", "f6r", "f6l", "wi1", {"x":84.588, "y":-2.898, "z":-0.381}, {"x":9, "y":9, "z":-59}, {"x":0, "y":0, "z":0}, 0, 1, 0, 1],
	],
	
	"audi6_workingWipers":{
		"frontWipersPresent": true,
		"frontWipersVolume": 2, //default is 1
		"stalkSmootherTime": 0.25, //default is 1
	},
	
	"soundscape": [
        ["name","src"],
		{"node:":"dsh1l", "descriptor":"AudioClosest3D"},
        ["frontWipers","art/sound/audi6/wipers/wipers.mp3"],
    ],
    "actionsEnabled": [
        ["id"],
		["wipers_F"],
		["wipers_F_down"],
    ],
},
"audi6_windshield": {
    "information":{
        "authors":"BeamNG",
        "name":"Windshield",
        "value":600,
    },
    "slotType" : "audi6_windshield",
    "slots": [
        ["type", "default", "description"],
        ["audi6_wipers_F","audi6_wipers_F", "Front Wipers"],
    ],
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         //glass
		 
         ["audi6_windshield_logo", ["audi6_windshield"]],
		 
         {"deformGroup":"windshield_break", "deformMaterialBase":"audi6_glass", "deformMaterialDamaged":"audi6_glass_dmg"},
         ["audi6_windshield", ["audi6_windshield"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>impact_glass_windscreen_01", "deformVolume":0.7}],         
		 
		 {"deformGroup":"windshield_break", "deformMaterialBase":"audi6_glass_int", "deformMaterialDamaged":"audi6_glass_int"},
         ["audi6_windshield_int", ["audi6_windshield"],[]{"deformSound":"event:>Destruction>Vehicle>Glass>impact_glass_windscreen_01", "deformVolume":0.7}],

         {"deformGroup":"windshield_break", "deformMaterialBase":"glass_invisible", "deformMaterialDamaged":"glass_mirror"},
         ["audi6_windshield_dmg", ["audi6_windshield"]],
         {"deformGroup":""},
    ],
    "sounds": {
        "$+cabinFilterCoef": 0.12
    }
    "nodes": [
         ["id", "posX", "posY", "posZ"],
         {"selfCollision":true},
         {"collision":true},
         {"frictionCoef":0.5},
         {"nodeMaterial":"|NM_GLASS"},
         {"nodeWeight":2.0},
         {"group":"audi6_windshield"},
         ["wi1", 0, -0.7267, 1.20{"group":["audi6_windshield","gps"]}],
         {"group":""},

         {"nodeMaterial":"|NM_METAL"},

         //--ADD WEIGHT--

         //windshield
         //a pillar
         {"nodeWeight":2.5},
         {"group":"audi6_body"},
         ["p1r", -0.62, -0.5832, 1.2247, {"group":["audi6_body","audi6_windshield"]}],
         ["p1l", 0.62, -0.5832, 1.2247, {"group":["audi6_body","audi6_windshield"]}],
         //roof
         {"nodeWeight":3.2},
         ["rf1r", -0.595, -0.2807, 1.3623, {"group":["audi6_body","audi6_windshield","audi6_roof"]}],
         ["rf1", 0, -0.34, 1.39, {"nodeWeight":2.7,"group":["audi6_body","audi6_windshield","audi6_roof"]}],
         ["rf1l", 0.595, -0.2807, 1.3623, {"group":["audi6_body","audi6_windshield","audi6_roof"]}],
         //firewall
         {"nodeWeight":8.4},
         //weight added by glass
         ["f6rr", -0.78, -0.9, 0.98, {"group":["audi6_engine_bay","gps","audi6_windshield","audi6_body","audi6_dash"]}],
         ["f6r", -0.33, -1.011, 1.0068, {"group":["audi6_engine_bay","gps","audi6_windshield","audi6_body","audi6_strutbar","audi6_dash"]}],
         ["f6l", 0.33, -1.011, 1.0068, {"group":["audi6_engine_bay","gps","audi6_windshield","audi6_body","audi6_strutbar","audi6_dash"]}],
         ["f6ll", 0.78, -0.9, 0.98, {"group":["audi6_engine_bay","gps","audi6_windshield","audi6_body","audi6_dash"]}],

         //windshield 12kg, rear window 10kg, coupe window 4kg, sedan window 3kg
         //1568kg
    ],

    "beams": [
          ["id1:", "id2:"],
          {"beamSpring":1470600,"beamDamp":120},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          //weak windshield beams
          {"disableMeshBreaking":true,"disableTriangleBreaking":true},
          {"beamDeform":10500,"beamStrength":"FLT_MAX"},
          {"deformGroup":"windshield_break","deformationTriggerRatio":0.02},
          {"deformLimitExpansion":""},

          ["rf1","wi1"],
          ["rf1r","wi1"],
          ["rf1l","wi1"],
          ["wi1","f6r"],
          ["wi1","f6l"],
          ["wi1","p1r"],
          ["wi1","p1l"],
          ["wi1","f6rr"],
          ["wi1","f6ll"],

          ["wi1","p2rr"],
          ["wi1","p2ll"],

          {"beamDeform":7500,"beamStrength":17500},
          ["rf1","f6r"],
          ["rf1","f6l"],

          ["p1r","p1l"],

          ["rf1r","f6r"],
          ["rf1l","f6l"],
          {"breakGroup":""},
          {"disableMeshBreaking":false,"disableTriangleBreaking":false},
          {"deformGroup":"", "deformationTriggerRatio":""},
          {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1.0, "beamShortBound":1.0},
          {"deformLimitExpansion":1.1},

    ],
    "triangles": [
            ["id1:","id2:","id3:"],
            {"groundModel":"glass"},
            {"group":"audi6_roof"},
            {"dragCoef":3.5},
            ["rf1r", "p1r", "rf1"],
            ["p1r", "wi1", "rf1"],
            ["p1r", "f6rr", "f6r"],
            ["f6r", "wi1", "p1r"],
            ["wi1", "p1l", "rf1"],
            ["rf1", "p1l", "rf1l"],
            ["wi1", "f6l", "p1l"],
            ["p1l", "f6l", "f6ll"],
            ["wi1", "f6r", "f6l"],
            {"group":""},
    ],
},
